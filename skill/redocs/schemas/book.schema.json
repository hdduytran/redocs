{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "redocs/book.schema.json",
  "title": "ReDocs book manifest (book.json)",
  "type": "object",
  "required": ["schemaVersion", "id", "title", "milestones", "chapters"],
  "additionalProperties": false,
  "patternProperties": { "^x-": true },
  "properties": {
    "$schema": { "type": "string" },
    "schemaVersion": { "const": 1 },
    "id": { "$ref": "#/$defs/slug" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "description": { "type": "string" },
    "language": { "type": "string", "pattern": "^[a-z]{2}(-[A-Z]{2})?$", "default": "en" },
    "milestones": {
      "description": "Architecture states of the system, in chronological order. Exactly one has status 'current'. These are NOT document versions; Git tags hold document history.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "status"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "label": { "type": "string", "minLength": 1 },
          "status": { "enum": ["superseded", "current", "planned", "target"] },
          "date": { "type": "string" },
          "description": { "type": "string" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "title", "pages"],
        "additionalProperties": false,
        "properties": {
          "id": { "$ref": "#/$defs/slug" },
          "title": { "type": "string", "minLength": 1 },
          "pages": { "type": "array", "items": { "$ref": "#/$defs/pageId" } }
        }
      }
    },
    "plugins": {
      "type": "object",
      "description": "Per-plugin settings, e.g. { \"archify\": { \"path\": \"~/.kiro/crew/skills/archify\" } }.",
      "additionalProperties": { "type": "object" }
    },
    "chat": {
      "type": "object",
      "description": "Opt-in 'Ask AI' panel in the built book. Off by default. When enabled, the reader's question and the book sections the model asks for are sent to the LLM endpoint the reader configures (their own API key or a local model); nothing is sent until they press Send.",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "provider": { "enum": ["anthropic", "openai-compatible"], "description": "Default provider shown to the reader; they can change it." },
        "model": { "type": "string", "minLength": 1 },
        "endpoint": { "type": "string", "pattern": "^https?://", "description": "Default endpoint; e.g. http://localhost:11434/v1/chat/completions for Ollama." },
        "maxToolRounds": { "type": "integer", "minimum": 1, "maximum": 12 },
        "maxTokens": { "type": "integer", "minimum": 256, "maximum": 16384 },
        "stream": { "type": "boolean", "description": "Stream replies token by token (default true; readers can turn it off)." }
      }
    }
  },
  "$defs": {
    "slug": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "pageId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*(/[a-z0-9][a-z0-9-]*)*$" }
  }
}
